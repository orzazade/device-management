# Copy to .env at the repo root (gitignored). Two readers, one file:
#
#   - the API on the host loads it via dotenv (repo root or apps/api)
#   - docker compose interpolates it into the `full` profile
#
# Real environment variables always take precedence over both.
#
# NOTE: DATABASE_URL, REDIS_URL and PORT below are host values. The `full`
# compose profile deliberately ignores them and uses its own service-name
# topology (db:5432, redis:6379) — see the comments in docker-compose.yml.

PORT=8080
DATABASE_URL=postgres://devmgmt:devmgmt@localhost:5433/devmgmt
REDIS_URL=redis://localhost:6380

# Public URL of the web app, used in email deeplinks.
APP_URL=http://localhost:5173

# Required in production (boot refuses without it)
JWT_SECRET=change-me
# Token lifetime (default 12h)
JWT_TTL=12h

# Timezone for the scheduled scans — overdue runs hourly, due-soon at 08:00
# local. Default 'Asia/Baku' (the team works UTC+4). Set this if the
# deployment lives in another zone, or reminders arrive at the wrong hour.
TZ_APP=Asia/Baku

# Passwords for the two seeded accounts (qa.admin@ / qa.tester@), read by the
# seed migration. They only apply on a database that has not run that
# migration yet — on an existing volume, change the passwords in the app.
# Unset falls back to the values in source control, which are public: set
# these for any deployment that matters.
QA_ADMIN_PASSWORD=
QA_TESTER_PASSWORD=

# Legacy: the retired admin@devicedesk.local seed. Kept because the earlier
# migration still reads it when replaying history onto a fresh database.
SEED_ADMIN_PASSWORD=

# Email delivery. Unset = mails wait in the outbox (visible in Settings).
# e.g. smtp://user:pass@mail.corp.local:587
SMTP_URL=
SMTP_FROM=DeviceDesk <devicedesk@localhost>

# --- docker compose only (not read by the API) -------------------------------
# Host ports, for when something already occupies the defaults.
# DB_PORT=5433
# REDIS_PORT=6380
# WEB_PORT=8088
