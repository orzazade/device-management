# Copy to .env (gitignored). apps/api reads these — see apps/api/src/config.ts
PORT=8080
DATABASE_URL=postgres://devmgmt:devmgmt@localhost:5433/devmgmt
REDIS_URL=redis://localhost:6380

# Required in production (boot refuses without it)
JWT_SECRET=change-me
# Token lifetime (default 12h)
JWT_TTL=12h

# First-boot seed admin password. Unset = 'admin123'; login then forces a
# change, and every production boot logs a security error until it is gone.
SEED_ADMIN_PASSWORD=

# Email delivery. Unset = mails wait in the outbox (visible in Settings).
# e.g. smtp://user:pass@mail.corp.local:587
SMTP_URL=
SMTP_FROM=DeviceDesk <devicedesk@localhost>
